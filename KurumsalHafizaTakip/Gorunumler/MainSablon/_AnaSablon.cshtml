<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>KHATS - Kurumsal Bellek</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>body { background: #0b0e14; color: #d1d1d1; } .nav-link { color: #8b949e !important; }</style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand text-info fw-bold" href="#">KHATS</a>
            <div class="d-flex">
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="nav-link me-3">@User.Identity.Name</span>
                    <a class="btn btn-outline-danger btn-sm" href="/Hesap/Cikis">Çıkış</a>
                }
            </div>
        </div>
    </nav>
    <div class="container">@RenderBody()</div>
</body>
</html>