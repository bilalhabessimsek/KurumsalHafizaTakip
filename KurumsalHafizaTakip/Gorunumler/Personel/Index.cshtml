@model IEnumerable<KurumsalHafizaTakip.VeriTabaniTabs.Kullanici>

@{
    // Eğer burada sadece "_AnaSablon" yazıyorsa hata alırsın.
    // Tam yolu aşağıdaki gibi mühürle:
    Layout = "~/Gorunumler/MainSablon/_AnaSablon.cshtml";
    ViewData["Title"] = "Personel Listesi";
}

<table class="table">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Email</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AdSoyad</td>
                <td>@item.Email</td>
                <td>
                    @if (item.Durum == "Aktif")
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pasif (Erişim Yok)</span>
                    }
                </td>
                <td>
                    @if (item.Durum == "Aktif" && item.Rol != "Admin")
                    {
                        <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sistemden Uzaklaştır</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>