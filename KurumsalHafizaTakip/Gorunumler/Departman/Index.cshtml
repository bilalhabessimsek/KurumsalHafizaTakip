@model IEnumerable<KurumsalHafizaTakip.Modeller.Departman>
@{
    Layout = "~/Gorunumler/MainSablon/_AnaSablon.cshtml";
}

<div class="container mt-4">
    <h2>Departman Yönetimi</h2>
    <hr />

    <a href="/Departman/Ekle" class="btn btn-primary mb-3">Yeni Departman Ekle</a>

    <table class="table table-bordered table-hover shadow-sm bg-white">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Departman Adı</th>
                <th>Açıklama</th>
                <th class="text-center" style="width: 150px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">@item.Id</td>
                        <td class="align-middle fw-bold text-primary">@item.Ad</td>
                        <td class="align-middle">@item.Aciklama</td>
                        <td class="text-center align-middle">

                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="menu_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    ⚙️ Yönet
                                </button>
                                <ul class="dropdown-menu shadow" aria-labelledby="menu_@item.Id">

                                    <li>
                                        <a class="dropdown-item" href="/Personel/Ekle?departmanId=@item.Id">
                                            👥 Personel Ekle
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="/Gorev/Ekle?departmanId=@item.Id">
                                            📋 Görev Ata
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" href="/Departman/Sil/@item.Id" onclick="return confirm('@item.Ad departmanını silmek istediğinize emin misiniz?');">
                                            🗑️ Sil
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        <i>Henüz sisteme eklenmiş bir departman bulunmuyor.</i>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>