@{
    Layout = null; // Giriş sayfasında ana şablonu (navbar vb.) istemiyoruz.
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Giriş - KHATS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0b0f19;
            color: white;
            display: flex;
            align-items: center;
            height: 100vh;
        }

        .login-card {
            background-color: #161b22;
            border: 1px solid #30363d;
            padding: 30px;
            border-radius: 10px;
            margin: auto;
            width: 350px;
        }

        .form-control {
            background-color: #0d1117;
            border: 1px solid #30363d;
            color: white;
        }
    </style>
</head>
<body>
    <div class="login-card shadow">
        <h3 class="text-center text-info mb-4">KHATS</h3>
        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger py-1 small">@ViewBag.Hata</div>
        }

        <form asp-action="Giris" method="post">
            <div class="mb-3">
                <label class="small text-white-50">Kullanıcı Adı</label>
                <input type="text" name="kullaniciAdi" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="small text-white-50">Şifre</label>
                <input type="password" name="sifre" class="form-control" required />
            </div>
            <button class="btn btn-info w-100 fw-bold">Giriş Yap</button>
        </form>
    </div>
</body>
</html>