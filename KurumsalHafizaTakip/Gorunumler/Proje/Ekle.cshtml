@model KurumsalHafizaTakip.VeriTabaniTabs.Proje
@{
    Layout = "~/Gorunumler/MainSablon/_AnaSablon.cshtml";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6">
        <div class="card bg-dark border-info shadow-lg">
            <div class="card-header bg-info text-dark fw-bold text-center">
                <h4 class="mb-0">🆕 Yeni Proje ve Sorumlu Atama</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post">
                    <div class="mb-3">
                        <label class="text-white-50 small">PROJE ADI</label>
                        <input type="text" name="ProjeAdi" class="form-control bg-dark text-white border-secondary" required />
                    </div>

                    <div class="mb-3">
                        <label class="text-white-50 small">PROJE SORUMLUSU (YÖNETİCİ)</label>
                        <select name="YoneticiId" class="form-select bg-dark text-white border-secondary" required>
                            <option value="">Bir Yönetici Seçin...</option>
                            @foreach (var yonetici in ViewBag.Yoneticiler)
                            {
                                <option value="@yonetici.Id">@yonetici.AdSoyad</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="text-white-50 small">AÇIKLAMA</label>
                        <textarea name="Aciklama" class="form-control bg-dark text-white border-secondary" rows="2"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-info fw-bold">Projeyi ve Sorumluyu Kaydet 🚀</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>