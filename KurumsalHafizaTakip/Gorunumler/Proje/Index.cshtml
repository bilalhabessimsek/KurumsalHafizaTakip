@model List<KurumsalHafizaTakip.VeriTabaniTabs.Proje>
@{
    Layout = "~/Gorunumler/MainSablon/_AnaSablon.cshtml";
}

<div class="card bg-dark border-info shadow-lg">
    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">📁 Proje ve Operasyon Yönetimi</h4>
        <a href="/Proje/Ekle" class="btn btn-dark btn-sm fw-bold">+ Yeni Proje Oluştur</a>
    </div>
    <div class="card-body">
        <table class="table table-dark table-hover">
            <thead>
                <tr class="text-info">
                    <th>Proje Adı</th>
                    <th>Sorumlu Yönetici</th>
                    <th>Açıklama</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.ProjeAdi</td>
                        <td>
                            <span class="badge bg-primary">👤 @(item.Yonetici?.AdSoyad ?? "Atanmadı")</span>
                        </td>
                        <td class="small text-white-50">@item.Aciklama</td>
                        <td class="text-center">
                            <a href="/Proje/IptalEt/@item.Id" class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Bu projeyi ve içindeki tüm bağlantıları iptal etmek üzeresiniz!')">
                                ❌ Projeyi İptal Et
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>