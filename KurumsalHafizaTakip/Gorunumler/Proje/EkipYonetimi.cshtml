@model KurumsalHafizaTakip.VeriTabaniTabs.Proje
@{
    ViewData["Title"] = "Ekip Seçimi";
}

<div class="card bg-dark border-info p-4 shadow-lg">
    <div class="d-flex justify-content-between">
        <h2 class="text-info">@Model.ProjeAdi - Ekip Yönetimi</h2>
        <span class="badge bg-warning text-dark p-2">Ekip: @(Model.Ekip?.Count ?? 0) / 10</span>
    </div>
    <hr class="border-secondary">

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger">@TempData["Hata"]</div>
    }

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="p-3 border border-secondary rounded">
                <h5 class="text-white mb-3">Ekibe Yeni Personel Ekle</h5>
                <form asp-action="EkipEkle" method="post">
                    <input type="hidden" name="projeId" value="@Model.Id" />
                    <div class="mb-3">
                        <select name="personelId" class="form-select bg-dark text-white border-secondary" required
                                asp-items="@(new SelectList(ViewBag.TumPersoneller, "Id", "AdSoyad"))">
                            <option value="">-- Personel Seçin --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-info w-100 fw-bold" @(Model.Ekip?.Count >= 10 ? "disabled" : "")>
                        Ekibe Dahil Et
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-7">
            <h5 class="text-success mb-3">Sorumlu Ekip Listesi</h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover border-secondary">
                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Mevcut Rol</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ekip != null && Model.Ekip.Any())
                        {
                            @foreach (var üye in Model.Ekip)
                            {
                                <tr>
                                    <td>@üye.Personel?.AdSoyad</td>
                                    <td><span class="badge border border-info">@üye.Personel?.Rol</span></td>
                                    <td class="text-end">
                                        <form asp-action="PersonelCikar" method="post" class="d-inline">
                                            <input type="hidden" name="ekipId" value="@üye.Id" />
                                            <input type="hidden" name="projeId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Kaldır</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-muted italic text-center">Henüz ekipte kimse yok.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3">← Projelere Dön</a>